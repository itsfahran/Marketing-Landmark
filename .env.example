# Supabase Configuration
# Get these from your Supabase project settings

# Server-side (Node.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Client-side (Vite/Browser) — same values, prefixed with VITE_
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Site Configuration
SITE_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# Optional: Analytics & Verification
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXX
VITE_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXXX
